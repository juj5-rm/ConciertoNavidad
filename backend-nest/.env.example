# Use the NestJS database only; never copy the Express database URL here.
NEST_DATABASE_URL=postgresql://USER:REPLACE_ME@localhost:5432/concierto_nest?schema=public

NODE_ENV=development
# Generate a random secret of at least 32 bytes. Keep the actual value out of Git.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Create React App uses port 3000 by default; Nest listens on 3001 locally.
PORT=3001
CORS_ORIGINS=http://localhost:3000

AUTH_COOKIE_NAME=concierto_auth
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
# Optional. Leave empty unless sharing a cookie across subdomains is required.
AUTH_COOKIE_DOMAIN=
